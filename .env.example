# ============================================
# Crunch-it Cafeteria WhatsApp Bot
# Environment Variables Template
# ============================================
# Copy this file to ".env" and fill in your real values.
# Never commit your real ".env" file to GitHub.

# --- Twilio Configuration ---
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# --- Email Notification (Gmail SMTP) ---
# For Gmail: enable "App Passwords" at https://myaccount.google.com/apppasswords
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password_here
NOTIFICATION_EMAIL=cafeteria_owner@gmail.com

# --- WhatsApp Notification ---
# Owner's WhatsApp number in E.164 format (e.g., +919876543210)
OWNER_WHATSAPP=+919876543210

# --- Server ---
PORT=3000
